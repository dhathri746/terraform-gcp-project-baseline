# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files as they may contain sensitive values
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Operating System and IDE files
.DS_Store
.vscode/
.idea/

# Ensure lockfile and example configs are NOT ignored
!.terraform.lock.hcl
!terraform.tfvars.example

